includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    # Static analysis of the application code (Larastan understands Eloquent, facades and the container).
    paths:
        - app/
        - routes/
        - database/seeders/

    # 0 = loosest, 10 = strictest. 6 also requires every array and collection to say what it holds.
    level: 6

    reportUnmatchedIgnoredErrors: true
